{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "service": {
    "name": "servohub.factory_service",
    "schema_version": 1,
    "protocol_revision": 1,
    "visibility": "factory_rnd_only",
    "product_contract_dependency": {
      "product_schema_version": 3,
      "protocol_revision": 1
    }
  },
  "capabilities": [
    {"name": "diagnostics.read", "bit": 0},
    {"name": "trace.capture", "bit": 1},
    {"name": "trace.pretrigger", "bit": 2},
    {"name": "trace.manual_trigger", "bit": 3},
    {"name": "trace.threshold_trigger", "bit": 4},
    {"name": "trace.bulk_read", "bit": 5}
  ],
  "protocol_enums": {
    "command": {"apply_config": 1, "arm": 2, "manual_trigger": 3, "refresh_status": 4},
    "trigger_mode": {"immediate": 0, "manual": 1, "rising": 2, "falling": 3},
    "trace_state": {"idle": 0, "armed": 1, "triggered": 2, "complete": 3, "error": 4},
    "status_code": {"ok": 0, "invalid_argument": -1, "busy": -2, "not_ready": -3, "out_of_range": -4}
  },
  "diagnostics": [
    {"id": "0x0001", "name": "power.dc_bus_voltage", "type": "float32", "unit": "V"},
    {"id": "0x0002", "name": "temperature.driver", "type": "float32", "unit": "degC"},
    {"id": "0x0003", "name": "temperature.mcu", "type": "float32", "unit": "degC"},
    {"id": "0x0004", "name": "temperature.motor", "type": "float32", "unit": "degC"},
    {"id": "0x0010", "name": "current.offset.phase_a", "type": "float32", "unit": "A"},
    {"id": "0x0011", "name": "current.offset.phase_b", "type": "float32", "unit": "A"},
    {"id": "0x0012", "name": "current.offset.phase_c", "type": "float32", "unit": "A"},
    {"id": "0x0020", "name": "encoder.motor.raw_count", "type": "uint32", "unit": "count"},
    {"id": "0x0021", "name": "encoder.load.raw_count", "type": "uint32", "unit": "count"},
    {"id": "0x0030", "name": "gate_driver.fault_bits", "type": "uint32", "unit": "bitmask"},
    {"id": "0x0040", "name": "timing.current_isr_overrun_count", "type": "uint32", "unit": "count"}
  ],
  "trace": {
    "max_channels": 8,
    "default_capacity_samples": 1024,
    "capacity_override_macro": "FACTORY_TRACE_CAPACITY",
    "base_clock": "current_control_isr",
    "trigger_modes": ["immediate", "manual", "rising", "falling"],
    "signals": [
      {"id": "0x0101", "name": "foc.id_ref", "type": "float32", "unit": "A"},
      {"id": "0x0102", "name": "foc.iq_ref", "type": "float32", "unit": "A"},
      {"id": "0x0103", "name": "foc.id_fb", "type": "float32", "unit": "A"},
      {"id": "0x0104", "name": "foc.iq_fb", "type": "float32", "unit": "A"},
      {"id": "0x0105", "name": "phase_current.a", "type": "float32", "unit": "A"},
      {"id": "0x0106", "name": "phase_current.b", "type": "float32", "unit": "A"},
      {"id": "0x0107", "name": "phase_current.c", "type": "float32", "unit": "A"},
      {"id": "0x0108", "name": "power.dc_bus_voltage", "type": "float32", "unit": "V"}
    ]
  },
  "canopen_binding": {
    "status": "wired",
    "binding_revision": 1,
    "transport": "canopen_sdo",
    "sdo_transfer": "expedited_only",
    "manufacturer_specific_range": "0x2200-0x2206",
    "objects": [
      {"index": "0x2200", "name": "Factory service info", "object_type": "record", "subindices": [
        {"subindex": 0, "name": "Number of entries", "type": "uint8", "access": "ro", "default": 6},
        {"subindex": 1, "name": "Schema version", "type": "uint16", "access": "ro", "default": 0},
        {"subindex": 2, "name": "Protocol revision", "type": "uint16", "access": "ro", "default": 0},
        {"subindex": 3, "name": "Capabilities", "type": "uint32", "access": "ro", "default": 0},
        {"subindex": 4, "name": "Trace capacity", "type": "uint16", "access": "ro", "default": 0},
        {"subindex": 5, "name": "Trace max channels", "type": "uint8", "access": "ro", "default": 0},
        {"subindex": 6, "name": "Base sample rate Hz", "type": "uint32", "access": "ro", "default": 0}
      ]},
      {"index": "0x2201", "name": "Trace configuration window", "object_type": "record", "subindices": [
        {"subindex": 0, "name": "Number of entries", "type": "uint8", "access": "ro", "default": 15},
        {"subindex": 1, "name": "Channel count", "type": "uint8", "access": "rw", "default": 0},
        {"subindex": 2, "name": "Channel 1", "type": "uint16", "access": "rw", "default": 0},
        {"subindex": 3, "name": "Channel 2", "type": "uint16", "access": "rw", "default": 0},
        {"subindex": 4, "name": "Channel 3", "type": "uint16", "access": "rw", "default": 0},
        {"subindex": 5, "name": "Channel 4", "type": "uint16", "access": "rw", "default": 0},
        {"subindex": 6, "name": "Channel 5", "type": "uint16", "access": "rw", "default": 0},
        {"subindex": 7, "name": "Channel 6", "type": "uint16", "access": "rw", "default": 0},
        {"subindex": 8, "name": "Channel 7", "type": "uint16", "access": "rw", "default": 0},
        {"subindex": 9, "name": "Channel 8", "type": "uint16", "access": "rw", "default": 0},
        {"subindex": 10, "name": "Sample divider", "type": "uint16", "access": "rw", "default": 1},
        {"subindex": 11, "name": "Pretrigger samples", "type": "uint16", "access": "rw", "default": 0},
        {"subindex": 12, "name": "Posttrigger samples", "type": "uint16", "access": "rw", "default": 0},
        {"subindex": 13, "name": "Trigger mode", "type": "uint8", "access": "rw", "default": 1},
        {"subindex": 14, "name": "Trigger channel", "type": "uint8", "access": "rw", "default": 0},
        {"subindex": 15, "name": "Trigger threshold", "type": "float32", "access": "rw", "default": 0.0}
      ]},
      {"index": "0x2202", "name": "Trace command", "object_type": "record", "subindices": [
        {"subindex": 0, "name": "Number of entries", "type": "uint8", "access": "ro", "default": 2},
        {"subindex": 1, "name": "Command", "type": "uint8", "access": "rw", "default": 0},
        {"subindex": 2, "name": "Last result", "type": "int32", "access": "ro", "default": 0}
      ]},
      {"index": "0x2203", "name": "Trace status", "object_type": "record", "subindices": [
        {"subindex": 0, "name": "Number of entries", "type": "uint8", "access": "ro", "default": 8},
        {"subindex": 1, "name": "State", "type": "uint8", "access": "ro", "default": 0},
        {"subindex": 2, "name": "Capture id", "type": "uint32", "access": "ro", "default": 0},
        {"subindex": 3, "name": "Base sample rate Hz", "type": "uint32", "access": "ro", "default": 0},
        {"subindex": 4, "name": "Effective sample rate Hz", "type": "uint32", "access": "ro", "default": 0},
        {"subindex": 5, "name": "Sample count", "type": "uint16", "access": "ro", "default": 0},
        {"subindex": 6, "name": "Trigger sample offset", "type": "uint16", "access": "ro", "default": 0},
        {"subindex": 7, "name": "Channel count", "type": "uint8", "access": "ro", "default": 0},
        {"subindex": 8, "name": "Sample divider", "type": "uint16", "access": "ro", "default": 0}
      ]},
      {"index": "0x2204", "name": "Trace data window", "object_type": "record", "subindices": [
        {"subindex": 0, "name": "Number of entries", "type": "uint8", "access": "ro", "default": 12},
        {"subindex": 1, "name": "Logical index", "type": "uint16", "access": "rw", "default": 0},
        {"subindex": 2, "name": "Read result", "type": "int32", "access": "ro", "default": 0},
        {"subindex": 3, "name": "Sequence", "type": "uint32", "access": "ro", "default": 0},
        {"subindex": 4, "name": "Value count", "type": "uint8", "access": "ro", "default": 0},
        {"subindex": 5, "name": "Value 1", "type": "float32", "access": "ro", "default": 0.0},
        {"subindex": 6, "name": "Value 2", "type": "float32", "access": "ro", "default": 0.0},
        {"subindex": 7, "name": "Value 3", "type": "float32", "access": "ro", "default": 0.0},
        {"subindex": 8, "name": "Value 4", "type": "float32", "access": "ro", "default": 0.0},
        {"subindex": 9, "name": "Value 5", "type": "float32", "access": "ro", "default": 0.0},
        {"subindex": 10, "name": "Value 6", "type": "float32", "access": "ro", "default": 0.0},
        {"subindex": 11, "name": "Value 7", "type": "float32", "access": "ro", "default": 0.0},
        {"subindex": 12, "name": "Value 8", "type": "float32", "access": "ro", "default": 0.0}
      ]},
      {"index": "0x2205", "name": "Diagnostic selector", "object_type": "variable", "type": "uint16", "access": "rw", "default": 0},
      {"index": "0x2206", "name": "Diagnostic value", "object_type": "record", "subindices": [
        {"subindex": 0, "name": "Number of entries", "type": "uint8", "access": "ro", "default": 2},
        {"subindex": 1, "name": "Read result", "type": "int32", "access": "ro", "default": 0},
        {"subindex": 2, "name": "Value", "type": "float32", "access": "ro", "default": 0.0}
      ]}
    ]
  },
  "safety": {
    "destructive_fault_injection": false,
    "host_rate_telemetry_is_trace_evidence": false,
    "unknown_schema_revision_policy": "fail_closed"
  }
}
